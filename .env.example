# Projet Supabase « Antichaos CRM » (région eu-west-3)
NEXT_PUBLIC_SUPABASE_URL=https://nsprahjpxdeqnoferpik.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_7NkNG81ab65rCqL90478bQ_Hoa1PDYx

# Clé service_role : uniquement côté serveur (invitations d'utilisateurs).
# À récupérer dans Supabase > Project Settings > API. Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Claude, pour le nettoyage assisté des imports CSV et l'analyse du
# pipeline. console.anthropic.com > API keys. Serveur uniquement.
ANTHROPIC_API_KEY=

# Uniquement si la clé ci-dessus est de type « Personnel / tous les espaces de
# travail » : l'API réclame alors l'espace à facturer. Une clé créée dans un
# espace de travail rend cette variable inutile.
ANTHROPIC_WORKSPACE_ID=

# --- Synchronisation Gmail (OAuth 2.0) -------------------------------------
# console.cloud.google.com > API et services > Identifiants > ID client OAuth,
# type « Application Web ». Activer l'API Gmail sur le projet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection autorisée, identique au caractère près à celle déclarée
# dans la console Google : https://<domaine>/api/google/callback
GOOGLE_REDIRECT_URI=

# Protège /api/cron/gmail-sync : Vercel signe ses appels planifiés avec cette
# valeur en Authorization: Bearer. Une chaîne aléatoire suffit ; à générer une
# fois et coller telle quelle dans Vercel (ex. `openssl rand -hex 24`).
CRON_SECRET=

# --- Synchronisation Claap -------------------------------------------------
# Secret partage du webhook Claap. Laisse vide, la route accepte toute requete :
# a ne faire qu'en developpement.
CLAAP_WEBHOOK_SECRET=
